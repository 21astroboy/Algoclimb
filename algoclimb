#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# AlgoClimb — единая команда управления сервером на VPS.
#
#   ./algoclimb up        собрать и запустить в фоне (история в ./data сохраняется)
#   ./algoclimb down      остановить
#   ./algoclimb restart   перезапустить (без пересборки образа)
#   ./algoclimb deploy    обновить код из git и пересобрать (origin/main)
#   ./algoclimb logs      смотреть логи (Ctrl+C — выйти)
#   ./algoclimb key       показать ключ преподавателя
#   ./algoclimb status    состояние контейнера
#
# ВАЖНО: restart НЕ пересобирает образ — код вшит в образ при сборке, поэтому
# после обновления кода/конфига нужен deploy (pull + rebuild), а не restart.
#
# По умолчанию использует Docker Compose. Если Docker нет — переключается на
# локальный запуск через Python venv (тот же ./data, та же БД).
#
# Настройки берутся из файла .env рядом со скриптом (см. .env.example).
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail
cd "$(dirname "$0")"

[ -f .env ] && set -a && . ./.env && set +a || true
PORT="${PORT:-3000}"

say()  { printf '%s\n' "$*"; }
die()  { printf 'Ошибка: %s\n' "$*" >&2; exit 1; }

# --- какой движок доступен ---
if docker compose version >/dev/null 2>&1; then
  DC="docker compose"; ENGINE="docker"
elif command -v docker-compose >/dev/null 2>&1; then
  DC="docker-compose"; ENGINE="docker"
else
  ENGINE="local"
fi

check_bank() {
  # Приватный банк (в .gitignore) — на свежем клоне его может не быть.
  # Ищем в примонтированной папке secrets/ (путь по умолчанию для Docker),
  # затем рядом с кодом (backend/data). Явный TASK_BANK_PATH тоже учитываем.
  if [ -n "${TASK_BANK_PATH:-}" ] && [ -f "${TASK_BANK_PATH}" ]; then return; fi
  if [ -f secrets/task-bank.json ] || [ -f backend/data/task-bank.json ]; then return; fi
  say "⚠  Приватный банк не найден — приложение запустится с демо-банком."
  say "   Положите файлы в папку secrets/ (см. secrets/README.md), например:"
  say "     scp secrets/task-bank.json secrets/explanations.json <user>@<vps>:$(pwd)/secrets/"
  say
}

up_docker() {
  check_bank
  mkdir -p backend/data/runtime
  say "Сборка и запуск (Docker)…"
  $DC up -d --build
  sleep 2
  say
  key_docker || true
  say
  say "Готово. Преподаватель: http://<адрес-сервера>:${PORT}/teacher"
  say "Логи: ./algoclimb logs   ·  Остановить: ./algoclimb down"
}

GIT_BRANCH="${GIT_BRANCH:-main}"

# Обновить код из git и пересобрать образ (одной командой).
# Именно это нужно после изменений в коде/конфиге: restart образ НЕ пересобирает.
deploy() {
  command -v git >/dev/null 2>&1 || die "git не установлен."
  [ -d .git ] || die "Это не git-репозиторий (запускайте из папки проекта)."
  say "Обновление кода из git (origin/${GIT_BRANCH})…"
  git fetch --quiet origin "$GIT_BRANCH" || die "git fetch не удался."
  git checkout --quiet "$GIT_BRANCH"
  git pull --ff-only origin "$GIT_BRANCH" || die "pull не fast-forward — на сервере есть локальные коммиты. Разберитесь вручную."
  say "Код на коммите: $(git log --oneline -1)"
  say
  if [ "$ENGINE" = docker ]; then
    check_bank
    mkdir -p backend/data/runtime
    say "Пересборка и запуск образа (Docker)…"
    $DC up -d --build
    sleep 2
    say
    key_docker || true
  else
    down_local
    up_local
  fi
  say
  say "Готово: код обновлён, образ пересобран и запущен."
}

key_docker() {
  local k
  k="$($DC logs algoclimb 2>/dev/null | grep -a 'КЛЮЧ ПРЕПОДАВАТЕЛЯ' | tail -1 | sed 's/.*КЛЮЧ ПРЕПОДАВАТЕЛЯ: //')"
  [ -n "${k:-}" ] && say "🔑 Ключ преподавателя: ${k}" || say "Ключ ещё не в логах — попробуйте: ./algoclimb logs"
}

# --- локальный режим без Docker ---
VENV=".venv"
ensure_venv() {
  command -v python3 >/dev/null 2>&1 || die "Не найден ни Docker, ни python3."
  [ -d "$VENV" ] || python3 -m venv "$VENV"
  "$VENV/bin/pip" install -q --upgrade pip
  "$VENV/bin/pip" install -q -r requirements.txt
}

up_local() {
  check_bank
  ensure_venv
  mkdir -p backend/data/runtime
  if [ -f algoclimb.pid ] && kill -0 "$(cat algoclimb.pid)" 2>/dev/null; then
    die "Уже запущено (PID $(cat algoclimb.pid)). Сначала ./algoclimb down."
  fi
  say "Запуск (локальный Python)…"
  PORT="$PORT" nohup "$VENV/bin/python" -m uvicorn main:app --app-dir backend \
      --host 0.0.0.0 --port "$PORT" --ws wsproto > algoclimb.out 2>&1 &
  echo $! > algoclimb.pid
  sleep 3
  grep -a 'КЛЮЧ ПРЕПОДАВАТЕЛЯ' algoclimb.out | tail -1 | sed 's/.*: /🔑 Ключ преподавателя: /' || true
  say "Готово (PID $(cat algoclimb.pid)). Логи: ./algoclimb logs"
}

down_local() {
  [ -f algoclimb.pid ] || { say "Не запущено."; return; }
  kill "$(cat algoclimb.pid)" 2>/dev/null || true
  rm -f algoclimb.pid
  say "Остановлено."
}

CMD="${1:-up}"
case "$CMD" in
  up)      [ "$ENGINE" = docker ] && up_docker || up_local ;;
  down)    [ "$ENGINE" = docker ] && $DC down || down_local ;;
  restart) [ "$ENGINE" = docker ] && { $DC restart; key_docker; } || { down_local; up_local; } ;;
  deploy|update) deploy ;;
  logs)    [ "$ENGINE" = docker ] && $DC logs -f --tail=100 || { touch algoclimb.out; tail -f algoclimb.out; } ;;
  key)     [ "$ENGINE" = docker ] && key_docker || { grep -a 'КЛЮЧ ПРЕПОДАВАТЕЛЯ' algoclimb.out | tail -1; } ;;
  status)  [ "$ENGINE" = docker ] && $DC ps || { [ -f algoclimb.pid ] && kill -0 "$(cat algoclimb.pid)" 2>/dev/null && say "работает (PID $(cat algoclimb.pid))" || say "остановлено"; } ;;
  *)       die "Неизвестная команда: $CMD (up|down|restart|deploy|logs|key|status)" ;;
esac
