# Скопируйте в .env и отредактируйте под свой сервер.  cp .env.example .env

# Порт, на котором слушает приложение (и наружу, и внутри контейнера маппится сюда).
PORT=3000

# Публичный адрес, который увидят студенты (в QR-коде и ссылке для входа).
# С доменом и HTTPS (рекомендуется, если стоит reverse-proxy):
#   PUBLIC_URL=https://algoclimb.example.ru
# Или напрямую по IP и порту:
#   PUBLIC_URL=http://203.0.113.10:3000
PUBLIC_URL=

# Альтернатива PUBLIC_URL — только адрес/IP без схемы (если PUBLIC_URL пуст).
HOST_IP=

# Постоянный ключ преподавателя. Если пусто — генерируется случайный при каждом старте
# (смотрите ./algoclimb key). Задайте свой, чтобы ключ не менялся.
TEACHER_KEY=

# Ротация одноразовых кодов входа (TOTP). 1 — включить, 0/пусто — выключить.
QR_ROTATION=
# Интервал смены кода в секундах (по умолчанию 8).
QR_INTERVAL=

# Swagger /docs. По умолчанию скрыт (студенты не видят API). 1 — показать.
DOCS=
# Выгрузка результатов в Google Sheets. 1 — включить кнопку (нужен service-account.json).
GSHEETS=

# ── Приватный банк задач ─────────────────────────────────────────────────────
# Пути к приватным файлам (вопросы+ответы и разборы). Их НЕ хранят в Git.
# В Docker по умолчанию читаются из примонтированной папки ./secrets — менять не нужно,
# просто положите туда файлы (см. secrets/README.md).
# Для запуска без Docker можно указать абсолютный путь, напр. /opt/algoclimb/secrets/…
# Пусто = искать backend/data/task-bank.json, иначе демо-банк task-bank.example.json.
TASK_BANK_PATH=
EXPLANATIONS_PATH=
# Необязательно: свой config.json вне репозитория.
CONFIG_PATH=
